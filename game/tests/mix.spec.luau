local Mix = load("Mix")

local function near(actual: number, expected: number, message: string)
	assert(math.abs(actual - expected) < 0.000001, message)
end

test("duck envelope has exact attack hold and release boundaries", function()
	near(Mix.envelope(-0.1, 0.2, 0.4, 0.4, 0.25), 1, "before")
	near(Mix.envelope(0, 0.2, 0.4, 0.4, 0.25), 1, "attack start")
	near(Mix.envelope(0.1, 0.2, 0.4, 0.4, 0.25), 0.625, "attack middle")
	near(Mix.envelope(0.2, 0.2, 0.4, 0.4, 0.25), 0.25, "hold start")
	near(Mix.envelope(0.6, 0.2, 0.4, 0.4, 0.25), 0.25, "release start")
	near(Mix.envelope(0.8, 0.2, 0.4, 0.4, 0.25), 0.625, "release middle")
	near(Mix.envelope(1, 0.2, 0.4, 0.4, 0.25), 1, "recovered")
	near(Mix.envelope(2, 0.2, 0.4, 0.4, 0.25), 1, "stays recovered")
end)

test("bus volumes clamp and mute without changing their inputs", function()
	eq(Mix.busVolume(-1, false), 0, "low clamp")
	eq(Mix.busVolume(2, false), 1, "high clamp")
	eq(Mix.busVolume(0.8, false, 0.5), 0.4, "gain")
	eq(Mix.busVolume(0.8, true, 0.5), 0, "mute")

	local buses = Mix.busVolumes(0.8, 0.6, false, 0.25)
	eq(buses.Music, 0.2, "music duck")
	eq(buses.Sfx, 0.6, "SFX unaffected")
	eq(buses.Ui, 0.6, "UI follows its bus")
	local muted = Mix.busVolumes(0.8, 0.6, true, 0.25)
	eq(muted.Music, 0, "music mute")
	eq(muted.Sfx, 0, "SFX mute")
	eq(muted.Ui, 0, "UI mute")
end)

test("sounds map to separate categories and stingers duck music", function()
	eq(Mix.categoryForSound("Music"), "Music", "music")
	eq(Mix.categoryForSound("Buy"), "Ui", "UI")
	eq(Mix.categoryForSound("ShotPistol"), "Sfx", "SFX")
	eq(Mix.categoryForSound("WaveClear"), "Sfx", "stinger bus")
	assert(Mix.isDuckingStinger("BossRoar"), "boss stinger")
	assert(Mix.isDuckingStinger("WaveClear"), "victory stinger")
	assert(Mix.isDuckingStinger("GameOver"), "defeat stinger")
	assert(not Mix.isDuckingStinger("ShotPistol"), "ordinary SFX")
end)
