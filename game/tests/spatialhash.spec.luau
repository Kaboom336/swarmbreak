local SpatialHash = load("SpatialHash")

local function pos(x, y, z)
	return { x = x, y = y or 0, z = z or 0 }
end

test("cell math floors negative coordinates", function()
	local x, y, z = SpatialHash.cellCoordinates(pos(-0.01, -10, -10.01), 10)
	eq(x, -1, "negative x")
	eq(y, -1, "negative y boundary")
	eq(z, -2, "negative z")
end)

test("moving an item updates its cell", function()
	local hash = SpatialHash.new(10)
	hash:insert("enemy", pos(1))
	eq(hash:move("enemy", pos(21)), true, "move existing")
	eq(#hash:queryRadius(pos(1), 2), 0, "old cell empty")
	eq(hash:queryRadius(pos(21), 2)[1], "enemy", "new cell contains item")
end)

test("removing an item excludes it", function()
	local hash = SpatialHash.new(10)
	hash:insert("enemy", pos(1))
	eq(hash:remove("enemy"), true, "first removal")
	eq(hash:remove("enemy"), false, "second removal")
	eq(#hash:queryRadius(pos(1), 2), 0, "removed item absent")
end)

test("queries include neighbors and exact radius boundaries", function()
	local hash = SpatialHash.new(10)
	hash:insert("left", pos(-0.01))
	hash:insert("edge", pos(10))
	hash:insert("outside", pos(10.001))
	local found = hash:queryRadius(pos(0), 10)
	eq(#found, 2, "only in-range neighbors")
	eq(found[1], "left", "closest across negative cell")
	eq(found[2], "edge", "inclusive radius boundary")
end)

test("radius results use stable distance ordering", function()
	local hash = SpatialHash.new(4)
	hash:insert("first", pos(-2))
	hash:insert("second", pos(2))
	hash:insert("nearest", pos(1))
	local found = hash:queryRadius(pos(0), 3)
	eq(found[1], "nearest", "distance order")
	eq(found[2], "first", "first equal-distance insertion")
	eq(found[3], "second", "second equal-distance insertion")
end)

test("reinserting an item moves it without duplicates", function()
	local hash = SpatialHash.new(10)
	hash:insert("enemy", pos(1))
	hash:insert("enemy", pos(11))
	local found = hash:queryRadius(pos(10), 20)
	eq(#found, 1, "one result")
	eq(found[1], "enemy", "same item")
end)
