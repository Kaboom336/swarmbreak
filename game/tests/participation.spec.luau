local Participation = load("Participation")

test("AFK sessions do not qualify", function()
	local state = Participation.new(0)
	eq(Participation.score(state, 120), 0, "no activity")
	eq(Participation.isEligible(state, 120), false, "AFK")
end)

test("support and low-skill activity can qualify without kills", function()
	local state = Participation.new(0)
	Participation.record(state, "DamageTaken", 20, 100)
	Participation.record(state, "RewardChoice", 1, 100)
	Participation.record(state, "Movement", 16, 100)
	assert(Participation.isEligible(state, 100), "mixed support activity qualifies")
end)

test("late joins are never blocked", function()
	local state = Participation.new(100, true)
	eq(Participation.isEligible(state, 101), true, "late join exemption")
end)

test("minimum score is inclusive", function()
	local below = Participation.new(0)
	Participation.record(below, "Kill", 1, 10)
	eq(Participation.isEligible(below, 10), false, "below minimum")
	Participation.record(below, "Movement", 8, 10)
	eq(Participation.score(below, 10), Participation.MinimumScore, "at minimum")
	eq(Participation.isEligible(below, 10), true, "minimum qualifies")
end)

test("old activity decays out of the recent window", function()
	local state = Participation.new(0)
	Participation.record(state, "Damage", 60, 0)
	Participation.record(state, "Kill", 1, 0)
	assert(Participation.score(state, 90) > 0, "partly decayed")
	eq(Participation.score(state, Participation.WindowSeconds), 0, "fully decayed")
	eq(Participation.isEligible(state, Participation.WindowSeconds), false, "no stale credit")
end)

test("a new run does not inherit prior activity", function()
	local first = Participation.new(0)
	Participation.record(first, "Kill", 1, 5)
	Participation.record(first, "Movement", 16, 5)
	assert(Participation.isEligible(first, 5), "first run qualifies")
	local second = Participation.new(10)
	eq(Participation.isEligible(second, 10), false, "reset is empty")
end)
